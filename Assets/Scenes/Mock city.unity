  requiredScore: 36000
  requiredTag: Player
  dialogueLines:
  - speakerName: Okara Police Dpt.
    sentence: Halt, you are currently in illegal possession of an A.P.M.E. brand
      SAT-IN delivery Drone.
  - speakerName: Okara Police Dpt.
    sentence: Failure to Comply will result in lethal force being used to apprehend
      you.
  - speakerName: SAT-URN
    sentence: Illegal possession? I am the delivery drone? Aren't I?
  - speakerName: '[SYSTEM]'
    sentence: Your delivery is on its way, check here to see your delivery drones
      location.
  - speakerName: SAT-URN
    sentence: What is this. Location Sharing with an unlisted drone?
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
