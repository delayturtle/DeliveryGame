  m_Name: 
  m_EditorClassIdentifier: 
  triggerType: 0
  triggerOnce: 1
  questManager: {fileID: 107353574}
  requiredScore: 27000
  requiredTag: Player
  dialogueLines:
  - speakerName: Johnathan Pizzeria
    sentence: Ay, saw that you were causing a ruckus up town.
  - speakerName: Johnathan Pizzeria
    sentence: I'm not sure if the yapping online is true, but if it is, maybe you
      could deliver?
  - speakerName: SAT-URN
    sentence: I'm not quite certain I understand?
  - speakerName: Johnathan Pizzeria
    sentence: All I'm saying is right now, you've got some heat on you, once that
      cools off I could take the kid off your hands?
  - speakerName: SAT-URN
    sentence: The.. Kid?
  - speakerName: '[Dial Tone]'
    sentence: '*Beeeep*'
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
